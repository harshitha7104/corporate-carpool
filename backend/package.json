{
  "name": "greenway-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch-path=src src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "lint": "node scripts/lint.js",
    "db:reset": "node scripts/resetDevDb.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "ws": "^8.18.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "embedded-postgres": "17.5.0-beta.15"
  },
  "license": "UNLICENSED",
  "description": "Green Way carpooling API, worker and realtime service"
}
